FROM python:3.11-slim
WORKDIR /app

# 1) Install OS-level dependency for LightGBM
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# 2) Copy & install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 3) Copy worker and modules
COPY worker.py .
COPY fsstate.py .
COPY training/ training/
COPY shared/ shared/
COPY profiling/ profiling/

# When using containerization these should be located in a shared volume
# COPY status.json .
# COPY training.csv .
# COPY latvian_places_with_coordinates_v2.sql .  # needed for distance enrichment

RUN touch /app/logs.log && chmod 666 /app/logs.log

RUN useradd --create-home appuser \
 && mkdir -p /shared \
 && chown appuser:appuser /shared
USER appuser

# 4) Set ENV variables and run via main() entry point
ENV MODEL_DIR=/app MODEL_BASENAME=model POLL_INTERVAL=60.0 STATUS_PATH=/app/status.json
CMD ["python", "worker.py"]
